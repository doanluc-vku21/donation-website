# Keep the browser Pixel and CAPI on the SAME dataset. Default is the site's
# existing Pixel, 2187720428848027. Never put tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_META_PIXEL_ID=2187720428848027
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Enable only after configuring the token and validating Meta Test Events.
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_TEST_EVENT_CODE=

# Vercel uses its trusted x-vercel-forwarded-for header automatically.
# On another host, enable only when the reverse proxy OVERWRITES X-Forwarded-For.
META_TRUST_PROXY_HEADERS=false

# Existing application configuration (configure using your deployment's secrets).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
RESEND_API_KEY=
